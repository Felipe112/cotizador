---
---

<footer class="pie">
  <div class="pie__firma">
    <span class="firma__linea" aria-hidden="true"></span>
    <span class="firma__texto">Firma autorizada</span>
  </div>

  <div class="pie__contacto">
    <input class="campo campo--contacto" placeholder="Teléfono · Correo · Sitio web" aria-label="Datos de contacto de tu empresa" />
    <p class="pie__gracias">Gracias por su preferencia.</p>
  </div>
</footer>

<style>
  .pie {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(200px, 240px);
    align-items: end;
    gap: 24px;
    margin-top: 6px;
    padding-top: 18px;
    border-top: 2px solid var(--brand-100);
  }

  .pie__contacto {
    display: grid;
    gap: 2px;
    justify-items: stretch;
  }

  .campo--contacto {
    font-size: 12.5px;
    color: var(--ink-soft);
  }

  .pie__gracias {
    padding: 0 8px;
    font-size: 12px;
    color: var(--muted);
  }

  .pie__firma {
    display: grid;
    gap: 6px;
    justify-items: center;
    max-width: 230px;
  }

  .firma__linea {
    width: 100%;
    height: 1px;
    background: var(--line-strong);
  }

  .firma__texto {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (max-width: 680px) {
    .pie {
      grid-template-columns: 1fr;
      justify-items: start;
    }
  }
</style>

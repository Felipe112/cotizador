---
// Filas iniciales visibles al abrir la plantilla.
const filasIniciales = 3;
---

<section class="tabla-wrap" aria-label="Detalle de productos o servicios">
  <table class="tabla" id="tabla-productos">
    <thead>
      <tr>
        <th class="col-num" scope="col">N.º</th>
        <th class="col-desc" scope="col">Producto o servicio</th>
        <th class="col-cant" scope="col">Cantidad</th>
        <th class="col-precio" scope="col">Precio unitario</th>
        <th class="col-total" scope="col">Total</th>
        <th class="col-acciones" scope="col"><span class="sr-only">Acciones</span></th>
      </tr>
    </thead>
    <tbody id="cuerpo-productos">
      {
        Array.from({ length: filasIniciales }).map(() => (
          <tr class="fila-producto">
            <td class="col-num"><span class="contador" /></td>
            <td class="col-desc">
              <input class="campo campo--desc" placeholder="Describe el producto o servicio" aria-label="Producto o servicio" />
            </td>
            <td class="col-cant">
              <input class="campo campo--num js-cantidad" type="number" min="0" step="1" placeholder="0" aria-label="Cantidad" />
            </td>
            <td class="col-precio">
              <input class="campo campo--num js-precio" type="number" min="0" step="0.01" placeholder="0.00" aria-label="Precio unitario" />
            </td>
            <td class="col-total">
              <span class="js-total-fila total-fila">—</span>
            </td>
            <td class="col-acciones">
              <button type="button" class="quitar js-quitar" aria-label="Quitar fila">
                <svg viewBox="0 0 20 20" width="15" height="15" aria-hidden="true">
                  <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
                </svg>
              </button>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>

  <!-- Molde usado por el script para agregar filas nuevas. -->
  <template id="molde-fila">
    <tr class="fila-producto">
      <td class="col-num"><span class="contador"></span></td>
      <td class="col-desc">
        <input class="campo campo--desc" placeholder="Describe el producto o servicio" aria-label="Producto o servicio" />
      </td>
      <td class="col-cant">
        <input class="campo campo--num js-cantidad" type="number" min="0" step="1" placeholder="0" aria-label="Cantidad" />
      </td>
      <td class="col-precio">
        <input class="campo campo--num js-precio" type="number" min="0" step="0.01" placeholder="0.00" aria-label="Precio unitario" />
      </td>
      <td class="col-total"><span class="js-total-fila total-fila">—</span></td>
      <td class="col-acciones">
        <button type="button" class="quitar js-quitar" aria-label="Quitar fila">
          <svg viewBox="0 0 20 20" width="15" height="15" aria-hidden="true">
            <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path>
          </svg>
        </button>
      </td>
    </tr>
  </template>

  <div class="barra-acciones">
    <button type="button" class="btn btn--suave" id="btn-agregar">
      <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
        <path d="M10 4v12M4 10h12" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path>
      </svg>
      Agregar producto
    </button>
  </div>
</section>

<style>
  .tabla-wrap {
    display: grid;
    gap: 12px;
  }

  .tabla {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    table-layout: fixed;
  }

  .tabla thead th {
    background: var(--brand-800);
    color: #eaf5f8;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: left;
    padding: 11px 10px;
  }

  .tabla thead th:first-child {
    border-top-left-radius: var(--radius-sm);
    border-bottom-left-radius: var(--radius-sm);
  }

  .tabla thead th:last-child {
    border-top-right-radius: var(--radius-sm);
    border-bottom-right-radius: var(--radius-sm);
  }

  .col-num { width: 46px; text-align: center; }
  .col-cant { width: 82px; }
  .col-precio { width: 112px; }
  .col-total { width: 116px; }
  .col-acciones { width: 34px; }

  .tabla thead .col-num { text-align: center; }
  .tabla thead .col-cant,
  .tabla thead .col-precio,
  .tabla thead .col-total { text-align: right; }

  .tabla tbody td {
    padding: 3px 4px;
    border-bottom: 1px solid var(--line);
    vertical-align: middle;
  }

  .fila-producto:nth-child(even) td {
    background: var(--brand-050);
  }

  .contador {
    display: inline-grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--brand-100);
    color: var(--brand-800);
    font-size: 12px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .col-num { text-align: center; }

  .campo--desc {
    font-weight: 500;
  }

  .total-fila {
    display: block;
    padding: 5px 8px;
    text-align: right;
    font-family: var(--font-num);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    color: var(--brand-900);
  }

  .total-fila[data-vacio="1"] {
    color: var(--muted);
    font-weight: 400;
  }

  /* Oculta las flechas del input number: ruido visual en una plantilla. */
  .campo--num::-webkit-outer-spin-button,
  .campo--num::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  .campo--num[type="number"] {
    -moz-appearance: textfield;
    appearance: textfield;
  }

  .quitar {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.15s ease, background-color 0.15s ease, color 0.15s ease;
  }

  .fila-producto:hover .quitar,
  .quitar:focus-visible {
    opacity: 1;
  }

  .quitar:hover {
    background: #fde8e8;
    color: #b4433b;
  }

  .barra-acciones {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (max-width: 680px) {
    .tabla { font-size: 13px; }
    .col-cant { width: 64px; }
    .col-precio { width: 88px; }
    .col-total { width: 92px; }
    .quitar { opacity: 1; }
  }
</style>

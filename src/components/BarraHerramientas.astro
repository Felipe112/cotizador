---
---

<div class="herramientas solo-pantalla">
  <div class="herramientas__marca">
    <strong>Cotizador</strong>
    <span>Llena la plantilla y descárgala en PDF.</span>
  </div>
  <div class="herramientas__botones">
    <button type="button" class="btn btn--suave" id="btn-limpiar">Limpiar todo</button>
    <button type="button" class="btn btn--suave" id="btn-imprimir">
      <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
        <path d="M6 8V3h8v5M6 15H4V9h12v6h-2M6 12h8v5H6z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"></path>
      </svg>
      Imprimir
    </button>
    <button type="button" class="btn btn--principal js-exportar-pdf">
      <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
        <path d="M10 3v9m0 0 3.5-3.5M10 12 6.5 8.5M4 14v2.5h12V14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      Exportar a PDF
    </button>
  </div>
</div>

<p class="aviso solo-pantalla" id="aviso-guardado" role="status" aria-live="polite"></p>

<style>
  .herramientas {
    width: min(100%, var(--page-w));
    margin: 0 auto 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .herramientas__marca {
    display: grid;
    line-height: 1.35;
  }

  .herramientas__marca strong {
    font-size: 15px;
    color: var(--brand-900);
  }

  .herramientas__marca span {
    font-size: 12.5px;
    color: var(--ink-soft);
  }

  .herramientas__botones {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .aviso {
    width: min(100%, var(--page-w));
    margin: 10px auto 0;
    font-size: 12px;
    color: var(--accent-700);
    min-height: 18px;
  }

  .aviso[data-error="1"] {
    color: #b4433b;
  }

  .btn[disabled] {
    opacity: 0.65;
    cursor: progress;
  }
</style>
